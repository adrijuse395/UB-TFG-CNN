{
    "global_settings": {
        "dataset": "cifar10",
        "model": "resnet20",
        "batch_size": 128,
        "use_gpu": false,
        "num_classes": 10,
        "pretrained": true,
        "fine_tuning": {
            "epochs": 1,
            "learning_rate": 0.0001,
            "early_stopping": true,
            "patience": 1,
            "min_improvement": 0.01,
            "monitor": "train_loss",
            "max_train_batches_per_epoch": 2,
            "max_val_batches_per_epoch": 1,
            "kfold": 1,
            "kfold_seed": 42,
            "checkpoint_strategy": "best_train",
            "val_overfit_ceiling": 100.0
        }
    },
    "resource_limits": {
        "max_rank": 4000,
        "max_batch_size": 256
