{
    "global_settings": {
        "dataset": "cifar10",
        "model": "vgg11_bn",
        "batch_size": 128,
        "use_gpu": true,
        "num_classes": 10,
        "pretrained": true,
        "fine_tuning": {
            "epochs": 5,
            "learning_rate": 0.001,
            "early_stopping": true,
            "patience": 3,
