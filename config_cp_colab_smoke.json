{
    "global_settings": {
        "dataset": "cifar10",
        "model": "vgg11_bn",
        "batch_size": 128,
        "use_gpu": true,
        "num_classes": 10,
        "pretrained": true,
        "execution": {
            "gpu": true,
            "on": "gpu"
        }
    },
    "resource_limits": {
        "max_rank": 64,
        "max_batch_size": 256
    },
    "method_defaults": {
        "CP": {
            "parafac_n_iter_max": 5000,
            "parafac_tol": 1e-06,
            "cp_parafac_on_cpu": false,
            "cp_init": "svd",
            "cp_normalize_factors": true
        }
    },
    "experiments": [
        {
            "name": "CP smoke rank 008 | no_ft",
            "method": "CP",
            "target_layers": [
                "features.0",
                "features.4",
                "features.8",
                "features.11",
                "features.15",
                "features.18",
                "features.22",
                "features.25"
            ],
            "rank": 8,
            "fine_tuning": false
        },
        {
            "name": "CP smoke rank 008 | ft",
            "method": "CP",
            "target_layers": [
                "features.0",
                "features.4",
                "features.8",
                "features.11",
                "features.15",
                "features.18",
                "features.22",
                "features.25"
            ],
            "rank": 8,
            "fine_tuning": true,
            "epochs": 2,
            "learning_rate": 0.0001,
            "early_stopping": true,
            "patience": 1,
            "min_improvement": 0.5,
            "monitor": "val_accuracy",
            "max_train_batches_per_epoch": 30,
            "max_val_batches_per_epoch": 15
        }
    ]
}
