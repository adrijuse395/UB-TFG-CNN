{
    "global_settings": {
        "dataset": "cifar10",
        "model": "vgg11_bn",
        "batch_size": 128,
        "use_gpu": true,
        "num_classes": 10,
        "pretrained": true,
        "execution": {
            "gpu": true,
            "on": "gpu"
        }
    },
    "resource_limits": {
        "max_rank": 64,
        "max_batch_size": 256
    },
    "method_defaults": {
        "CP_GD": {
            "cp_gd_steps": 400,
            "cp_gd_lr": 0.01,
            "cp_gd_on_cpu": true,
            "cp_gd_init": "svd",
            "cp_gd_scheduler_patience": 200
        }
    },
    "experiments": [
        {
            "name": "Smoke Tucker rank 32 | ft",
            "method": "Tucker",
            "target_layers": [
                "features.0",
                "features.4",
                "features.8",
                "features.11",
                "features.15",
                "features.18",
                "features.22",
                "features.25"
            ],
            "rank": 32,
            "fine_tuning": true,
            "epochs": 2,
            "learning_rate": 0.0001,
            "early_stopping": true,
            "patience": 2,
            "min_improvement": 0.1,
            "monitor": "val_accuracy",
            "max_train_batches_per_epoch": 40,
            "max_val_batches_per_epoch": 15
        },
        {
            "name": "Smoke CP_GD rank 32 | ft",
            "method": "CP_GD",
            "target_layers": [
                "features.0",
                "features.4",
                "features.8",
                "features.11",
                "features.15",
                "features.18",
                "features.22",
                "features.25"
            ],
            "rank": 32,
            "fine_tuning": true,
            "epochs": 2,
            "learning_rate": 0.0001,
            "early_stopping": true,
            "patience": 2,
            "min_improvement": 0.1,
            "monitor": "val_accuracy",
            "max_train_batches_per_epoch": 40,
            "max_val_batches_per_epoch": 15
        },
        {
            "name": "Smoke TT rank 32 | ft",
            "method": "TT",
            "target_layers": [
                "features.0",
                "features.4",
                "features.8",
                "features.11",
                "features.15",
                "features.18",
                "features.22",
                "features.25"
            ],
            "rank": 32,
            "fine_tuning": true,
            "epochs": 2,
            "learning_rate": 0.0001,
            "early_stopping": true,
            "patience": 2,
            "min_improvement": 0.1,
            "monitor": "val_accuracy",
            "max_train_batches_per_epoch": 40,
            "max_val_batches_per_epoch": 15
        }
    ]
}
